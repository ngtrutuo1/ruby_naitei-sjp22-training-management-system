<%= search_form_for @q, url: admin_user_path(@user_supervisor), method: :get, html: { class: "filter-form", data: { turbo: false } } do |f| %>
  <div class="row g-3">
    <div class="col-md-3">
      <%= f.text_field :name_cont,
          placeholder: t(".search_placeholder"),
          class: "form-control search-input" %>
    </div>

    <div class="col-md-2">
      <%= f.select :status_eq,
          options_for_select(user_course_status_options),
          {include_blank: t(".status_all")},
          class: "form-select status-select" %>
    </div>

    <div class="col-md-3">
      <%= f.select :id_eq,
          options_for_select(Course.recent.map { |c| [c.name, c.id] }),
          { include_blank: t(".course_all") },
          class: "form-select course-select" %>
    </div>

    <div class="col-md-2">
      <%= f.submit t(".apply"), class: "btn btn-primary apply-btn w-100" %>
    </div>

    <div class="col-md-2">
      <%= link_to t(".reset_filters"),
          admin_user_path(@user_supervisor),
          class: "btn btn-outline-secondary reset-btn w-100" %>
    </div>
  </div>
<% end %>
