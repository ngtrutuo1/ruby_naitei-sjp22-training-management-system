<div class="card p-3 mb-4">
  <div class="container-fluid">
    <div class="row align-items-center">
      <div class="col-xs-8">
        <%= search_form_for @q, url: admin_daily_reports_path, method: :get, html: {class: "form-inline"} do |f| %>
          
          <!-- Filter by course -->
          <%= f.select :course_id_eq, 
                options_for_select(Course.all.map {|c| [c.name, c.id]}, @q.course_id_eq),
                {prompt: t("shared.filter.select_course_placeholder")},
                class: "form-control form-select me-2" %>

          <!-- Filter by trainee user -->
          <%= f.select :user_id_eq, 
                options_for_select(User.trainee.map {|u| [u.name, u.id]}, @q.user_id_eq),
                {prompt: t("shared.filter.select_user_placeholder")},
                class: "form-control form-select me-2" %>

          <!-- Filter by date -->
          <%= f.date_field :created_at_eq, value: params.dig(:q, :created_at_eq), class: "form-control date-picker" %>

          <%= f.submit t("shared.filter.apply_filter"), class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
