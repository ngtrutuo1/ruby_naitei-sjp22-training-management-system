<%= search_form_for @q, url: admin_admin_users_path, method: :get, html: {class: "filter-form row g-3 align-items-end"} do |f| %>

  <!-- Search by name/email -->
  <div class="col-md-7">
    <div class="form-group">
      <label class="form-label"><%= t(".search_by") %></label>
      <div class="input-group">
        <span class="input-group-text"><%= t(".name") %></span>
        <%= f.search_field :name_or_email_cont,
                           class: "form-control",
                           placeholder: t(".search_placeholder") %>
      </div>
    </div>
  </div>

  <!-- Status filter -->
  <div class="col-md-2">
    <div class="form-group">
      <label class="form-label"><%= t(".status") %></label>
      <%= f.select :confirmed_at_null,
          options_for_select([
            [t(".status_all"), nil],
            [t(".status_inactive"), true],
            [t(".status_active"), false]
          ], params.dig(:q, :confirmed_at_null)),
          {},
          {class: "form-select"} %>
    </div>
  </div>

  <!-- Action buttons -->
  <div class="col-md-3 d-flex justify-content-start gap-2">
    <div class="form-group">
      <%= f.submit t(".apply_button"), class: "btn btn-primary" %>
      <%= link_to t(".clear_filter_button"), admin_admin_users_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

<% end %>
