<%= search_form_for @q, url: admin_admin_users_path, method: :get, html: {class: "filter-form"} do |f| %>
  <div class="row">
    <div class="col-md-7">
      <%= f.label :name_or_email_cont, t(".search_by") %>
      <%= f.text_field :name_or_email_cont, placeholder: t(".search_placeholder"), class: "form-control" %>
    </div>

    <div class="col-md-2">
      <%= f.label :confirmed_at_null, t(".status") %>
      <%= f.select :confirmed_at_null, options_for_select(user_status_filter_options, @q.confirmed_at_null), class: "form-control" %>
    </div>

    <div class="col-md-3">
      <%= f.submit t(".apply_button"), class: "btn btn-primary" %>
      <%= link_to t(".clear_filter_button"), admin_admin_users_path, class: "btn btn-default" %>
    </div>
  </div>
<% end %>
