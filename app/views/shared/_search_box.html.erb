<div class="search-form-wrapper">
  <%= search_form_for @q, url: path_to_search, method: :get, html: { class: "d-flex", id: "search-form" }, local: true do |f| %>
    <%= f.search_field :name_cont, 
                       value: params.dig(:q, :name_cont), 
                       class: "form-control", 
                       placeholder: t(".search") %>
  <% end %>
</div>
