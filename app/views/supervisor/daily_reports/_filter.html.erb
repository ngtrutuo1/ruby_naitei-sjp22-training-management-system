<div class="card p-3 mb-4">
  <div class="container-fluid">
    <div class="row align-items-center">
      <div class="col-xs-12 col-md-8">
        <%= search_form_for @q, url: supervisor_daily_reports_path, method: :get, class: "form-inline", local: true do |f| %>
          
          <!-- Course Select -->
          <div class="me-2 mb-2">
            <%= f.select :course_id_eq,
                  options_for_select(current_user.supervised_courses.map {|c| [c.name, c.id]}, params.dig(:q, :course_id_eq)),
                  {prompt: t("shared.filter.select_course_placeholder")},
                  class: "form-control form-select" %>
          </div>
          
          <!-- User Select -->
          <div class="me-2 mb-2">
            <%= f.select :user_id_eq,
                  options_for_select(User.trainee.by_course(current_user.supervised_course_ids).distinct.map {|u| [u.name, u.id]}, params.dig(:q, :user_id_eq)),
                  {prompt: t("shared.filter.select_user_placeholder")},
                  class: "form-control form-select" %>
          </div>
          
          <!-- Filter Date -->
          <div class="me-2 mb-2">
            <%= f.date_field :created_at_eq, value: params.dig(:q, :created_at_eq), class: "form-control date-picker" %>
          </div>
          
          <!-- Submit -->
          <%= f.submit t("shared.filter.apply_filter"), class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
