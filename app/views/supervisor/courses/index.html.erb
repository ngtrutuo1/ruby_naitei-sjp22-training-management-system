<% provide :title, t(".title") %>

<div class="content-container">

  <div class="page-controls-container">
    <div class="top-action-area flex-container space-between align-center">
      <h2 class="page-title"><%= t(".title") %></h2>
      <%= link_to t(".add_course_button"), new_supervisor_course_path, class: "btn btn-success height-fit" %>
    </div>

    <%= search_form_for @q, url: supervisor_courses_path, method: :get, class: "filter-form", local: true do |f| %>
      <div class="row">
        <div class="col-md-7">
          <div class="form-group">
            <label for="search_query"><%= t(".search_by") %></label>
            <div class="input-group unified-search-group">
              <span class="input-group-btn">
                <%= select_tag :search_type,
                               options_for_select(search_type_options, params[:search_type]),
                               class: "form-control search-type-select" %>
              </span>
              <%= f.search_field :name_cont, 
                                 value: params.dig(:q, :name_cont),
                                 class: "form-control",
                                 placeholder: t(".search_placeholder") %>
            </div>
          </div>
        </div>

        <div class="col-md-2">
          <div class="form-group">
            <label for="status"><%= Course.human_attribute_name(:status) %></label>
            <%= f.select :status_eq, status_filter_options, {}, class: "form-control" %>
          </div>
        </div>

        <div class="col-md-3">
          <div class="form-group filter-action-buttons-group">
            <label>&nbsp;</label>
            <div class="filter-action-buttons">
              <%= f.submit t(".apply_button"), class: "btn btn-primary width-fit" %>
              <%= link_to t(".clear_filter_button"), supervisor_courses_path, class: "btn btn-default" %>
            </div>
          </div>
        </div>
      </div>

      <div class="row filter-row-secondary">
        <div class="col-md-5">
          <div class="form-group">
            <label for="start_date"><%= t(".start_date_range") %></label>
            <div class="input-group">
              <%= f.date_field :start_date_gteq, value: params.dig(:q, :start_date_gteq), class: "form-control" %>
              <span class="input-group-addon">-</span>
              <%= f.date_field :finish_date_lteq, value: params.dig(:q, :finish_date_lteq), class: "form-control" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%= render "courses_table", courses: @courses %>

  <div class="pagination-wrapper">
    <%== pagy_bootstrap_nav @pagy %>
  </div>
</div>
